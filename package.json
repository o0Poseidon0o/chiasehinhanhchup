{
  "name": "chiasehinhanhchup",
  "version": "1.0.0",
  "description": "Photo Selection Web App - Nền tảng chia sẻ và chọn ảnh trực tuyến chuyên nghiệp",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm run --prefix server dev",
    "server:start": "npm run --prefix server start",
    "client": "npm run --prefix client dev",
    "client:build": "npm run --prefix client build",
    "build": "npm run --prefix client build",
    "install-all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
